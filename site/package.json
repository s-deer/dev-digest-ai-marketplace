{
  "name": "marketplace-catalog-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Static catalog of the marketplace plugins, skills and agents, published on GitHub Pages",
  "scripts": {
    "build:index": "npm --prefix .. run build:index",
    "dev": "npm run build:index && vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
